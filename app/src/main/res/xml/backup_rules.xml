<?xml version="1.0" encoding="utf-8"?>
<!--
   PRIX Auto Backup rules (Android 11 and lower).
   Strictly excludes all user documents, thumbnails, signatures, and the local Room database
   (which stores file metadata and extracted OCR text) so sensitive documents never leave
   the device implicitly via cloud backup. Only non-sensitive DataStore UI preferences remain eligible.
-->
<full-backup-content>
    <exclude domain="file" path="prix_vault" />
    <exclude domain="file" path="prix_vault/" />
    <exclude domain="database" path="prix_documents.db" />
    <exclude domain="database" path="prix_documents.db-wal" />
    <exclude domain="database" path="prix_documents.db-shm" />
    <exclude domain="database" path="prix_documents.db-journal" />
</full-backup-content>
